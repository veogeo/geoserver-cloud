<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.veogeo.geoservercloud</groupId>
    <artifactId>veogeo-geoserver-cloud-overlays</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>veogeo-geoserver-cloud-oidc-login</artifactId>
  <packaging>jar</packaging>
  <description>Provider-agnostic GeoServer WebUI login through OpenID Connect.</description>
  <dependencies>
    <dependency>
      <groupId>org.geoserver</groupId>
      <artifactId>gs-main</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.geoserver.web</groupId>
      <artifactId>gs-web-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.geoserver.extension</groupId>
      <artifactId>gs-sec-oidc-core</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.geoserver</groupId>
          <artifactId>gs-main</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.web</groupId>
          <artifactId>gs-web-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.geoserver.extension</groupId>
      <artifactId>gs-sec-oidc-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.geoserver</groupId>
          <artifactId>gs-main</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.geoserver.web</groupId>
          <artifactId>gs-web-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.geoserver.cloud.build</groupId>
      <artifactId>gs-spring-config-transpiler</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.geoserver.cloud</groupId>
      <artifactId>gs-spring-configuration</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-autoconfigure-processor</artifactId>
            </path>
            <path>
              <groupId>org.geoserver.cloud.build</groupId>
              <artifactId>gs-spring-config-transpiler</artifactId>
              <version>${project.version}</version>
            </path>
            <path>
              <groupId>org.geoserver</groupId>
              <artifactId>gs-main</artifactId>
              <version>${gs.version}</version>
            </path>
            <path>
              <groupId>org.geoserver.web</groupId>
              <artifactId>gs-web-core</artifactId>
              <version>${gs.version}</version>
            </path>
            <path>
              <groupId>jakarta.servlet</groupId>
              <artifactId>jakarta.servlet-api</artifactId>
            </path>
            <path>
              <groupId>org.springframework</groupId>
              <artifactId>spring-webmvc</artifactId>
            </path>
            <path>
              <groupId>org.geoserver.extension</groupId>
              <artifactId>gs-sec-oidc-core</artifactId>
              <version>${gs.version}</version>
            </path>
            <path>
              <groupId>org.geoserver.extension</groupId>
              <artifactId>gs-sec-oidc-web</artifactId>
              <version>${gs.version}</version>
            </path>
          </annotationProcessorPaths>
          <proc>full</proc>
          <generatedSourcesDirectory>${project.build.directory}/generated-sources/transpiled-configurations</generatedSourcesDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
